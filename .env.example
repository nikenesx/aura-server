HTTP_ADDR=:8080
LOG_LEVEL=info
# Overridden to http://asr:8090 inside Docker Compose
ASR_URL=http://127.0.0.1:8090
MAX_UPLOAD_BYTES=104857600
ASR_TIMEOUT=30m
JOB_TTL=2h

# Python ASR
HF_TOKEN=
GIGAAM_MODEL=v3_e2e_rnnt
DIAR_MODEL=pyannote/speaker-diarization-3.1
DIAR_SPEAKERS=2
# 0.2 halves diarization time; validate on real recordings before switching
DIAR_SEGMENTATION_STEP=0.1
ASR_BATCH_SIZE=16
