HTTP_ADDR=:8080
LOG_LEVEL=info
# Overridden to http://asr:8090 inside Docker Compose
ASR_URL=http://127.0.0.1:8090
MAX_UPLOAD_BYTES=104857600
ASR_TIMEOUT=30m
JOB_TTL=2h

# Python ASR
HF_TOKEN=
GIGAAM_MODEL=v3_e2e_rnnt
DIAR_MODEL=pyannote/speaker-diarization-3.1
DIAR_SPEAKERS=2
# 0.2 halves diarization time; validate on real recordings before switching
DIAR_SEGMENTATION_STEP=0.1
ASR_BATCH_SIZE=16

# Appointment cards (vLLM). Empty LLM_URL disables cards.
# Overridden to http://llm:8000 inside Docker Compose
LLM_URL=http://127.0.0.1:8000
LLM_MODEL=t-lite
LLM_TIMEOUT=5m
# vLLM container: share of the whole GPU it may take, and context length.
# 24 GB (RTX 4090): 0.6 / 32768. 16 GB: about 0.7 / 16384, which fits
# recordings up to roughly 30 minutes.
LLM_GPU_MEMORY_UTILIZATION=0.6
LLM_MAX_MODEL_LEN=32768
